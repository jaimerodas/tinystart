# The Dockerfile copies go.mod, go.sum, cmd/ and internal/ by name, so the
# build context barely matters — this just keeps the biggest non-sources out
# of the upload. Nothing here may exclude those four paths: ignoring any of
# them fails the build outright rather than quietly.
/.git/
/.gitignore

# Ignore all environment files.
/.env*

# The development database.
/storage/

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# The binary a bare `go build` drops at the repo root.
/tinystart
