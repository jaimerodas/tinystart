KAMAL_REGISTRY_PASSWORD=$(op read op://Developer/TinyStart/kamal_registry_password)
TINYSTART_SECRET_KEY=$(op read op://Developer/TinyStart/secret_key)
POSTMARK_API_TOKEN=$(op read op://Developer/TinyStart/postmark_api)

# Not injected into the container: .kamal/hooks/post-deploy reads these
# instead and writes them to /etc/tinystart-backup.env on the server for
# bin/backup_db.
B2_KEY_ID=$(op read op://Developer/TinyStart/b2_key_id)
B2_APPLICATION_KEY=$(op read op://Developer/TinyStart/b2_application_key)
B2_ENDPOINT=$(op read op://Developer/TinyStart/b2_endpoint)
B2_BUCKET=$(op read op://Developer/TinyStart/b2_bucket)
