#!/bin/bash
# Copies the production database to Backblaze B2. Installed on the server at
# /usr/local/bin/tinystart-backup by .kamal/hooks/post-deploy, and run weekly by
# /etc/cron.d/tinystart-backup.
#
# Weekly rather than the nightly that tinylinks and gastitos use: a start page is
# a few dozen hand-curated tiles that change when you decide to change them, and
# a week of lost edits is a few minutes of retyping.
#
# It is not conditional on the data having changed. That was the first idea, and
# it does not work here — visit_count increments on every tile click, so the file
# differs from the last one almost always and a content check would upload every
# week regardless while costing a hash comparison to learn nothing.
set -euo pipefail

set -a
source /etc/tinystart-backup.env
set +a

TIMESTAMP=$(date +%Y-%m-%d_%H%M)
DUMP_FILE="tinystart-${TIMESTAMP}.sqlite3"

trap 'rm -f "/tmp/${DUMP_FILE}"' EXIT

echo "[$(date)] Starting backup..."

CONTAINER=$(docker ps --filter label=service=tinystart --filter label=role=web --format "{{.Names}}" | head -1)

if [ -z "$CONTAINER" ]; then
  echo "[$(date)] No running tinystart web container; nothing to back up." >&2
  exit 1
fi

# .backup rather than a file copy: it takes a consistent snapshot of a live
# database instead of catching it mid-write. Only production.sqlite3 —
# production_cache.sqlite3 is Solid Cache and regenerates itself.
docker exec "$CONTAINER" sqlite3 /rails/storage/production.sqlite3 ".backup '/tmp/backup.sqlite3'"
docker cp "$CONTAINER:/tmp/backup.sqlite3" "/tmp/${DUMP_FILE}"
docker exec "$CONTAINER" rm /tmp/backup.sqlite3

# Worth the second it costs: this is the only copy of tiles that were curated by
# hand, and an unreadable backup that uploaded cleanly is worse than a failure,
# because nothing tells you until you need it.
INTEGRITY=$(sqlite3 "/tmp/${DUMP_FILE}" "PRAGMA integrity_check;" 2>&1 || echo "unreadable")
if [ "$INTEGRITY" != "ok" ]; then
  echo "[$(date)] Refusing to upload: integrity check said '${INTEGRITY}'" >&2
  exit 1
fi

TILES=$(sqlite3 "/tmp/${DUMP_FILE}" "SELECT COUNT(*) FROM start_page_items;")
if [ "$TILES" -eq 0 ]; then
  echo "[$(date)] Refusing to upload: the snapshot holds no tiles." >&2
  exit 1
fi

aws s3 cp "/tmp/${DUMP_FILE}" "s3://${B2_BUCKET}/tinystart/weekly/${DUMP_FILE}"

echo "[$(date)] Backup complete: ${DUMP_FILE} (${TILES} tiles)"
