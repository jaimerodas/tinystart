#!/usr/bin/env bash
# The parity harness: the same sequence against Rails and against Go, diffed.
#
#   script/parity/run            # everything
#   script/parity/run -v         # …and print the diffs
#   script/parity/run show edit  # …only these captures, from the last run
#
# Ten seconds or so. Not part of script/test: it needs Ruby, three ports and a
# Rails boot. Dies with the Rails tree in phase 9.
set -euo pipefail

cd "$(dirname "$0")/../.."
ROOT=$PWD

# Where the two apps, the fake and the captures live. Under tmp/, which git
# ignores, so the raw captures and the diffs are there to read afterwards.
OUT=${PARITY_OUT:-$ROOT/tmp/parity}
RAILS_PORT=${PARITY_RAILS_PORT:-3097}
FAKE_PORT=${PARITY_FAKE_PORT:-3098}
GO_PORT=${PARITY_GO_PORT:-3099}
RAILS_BASE=http://127.0.0.1:$RAILS_PORT
GO_BASE=http://127.0.0.1:$GO_PORT
FAKE_BASE=http://127.0.0.1:$FAKE_PORT

SOURCE_DB=${PARITY_DB:-$ROOT/storage/development.sqlite3}
FIXTURE=$ROOT/test/fixtures/files/start_page.yml

pids=()
cleanup() {
  for pid in ${pids[@]+"${pids[@]}"}; do kill "$pid" 2>/dev/null || true; done
}
trap cleanup EXIT

wait_for() { # wait_for <url> <what>
  for _ in $(seq 1 120); do
    if curl -sS -o /dev/null "$1" 2>/dev/null; then return 0; fi
    sleep 0.5
  done
  echo "$2 never came up at $1" >&2
  exit 1
}

prepare_db() { # prepare_db <destination>
  rm -f "$1" "$1-wal" "$1-shm"
  cp "$SOURCE_DB" "$1"
  # A database in WAL mode keeps its newest transactions in the file beside it,
  # so that comes too — otherwise the copy is the database as of the last
  # checkpoint, which is not what anyone means by "a copy". Nothing here ever
  # opens the source: it is somebody's working database.
  if [ -f "$SOURCE_DB-wal" ]; then cp "$SOURCE_DB-wal" "$1-wal"; fi
  # DELETE folds that -wal into the copy and leaves one file, so a killed
  # server cannot leave a -wal behind to confuse the next run.
  sqlite3 "$1" "PRAGMA journal_mode=DELETE;" > /dev/null
  sqlite3 "$1" < "$ROOT/script/parity/seed.sql"
}

# The source is read once, here, and its fingerprint checked again at the end:
# the harness drives two apps through every write the app has, and if either of
# them were ever pointed at this file instead of at its copy, the first
# symptom would be somebody's start page rearranging itself.
source_fingerprint() { shasum "$SOURCE_DB" | cut -d' ' -f1; }
BEFORE=$(source_fingerprint)

mkdir -p "$OUT"

# Named captures mean "diff those, from what is already on disk": no build and
# no servers. Flags on their own — -v — still run the whole thing.
names=()
for argument in "$@"; do
  case $argument in -*) ;; *) names+=("$argument") ;; esac
done
if [ ${#names[@]} -gt 0 ]; then
  exec python3 script/parity/diff.py --rails "$OUT/rails" --go "$OUT/go" \
    --rails-base "$RAILS_BASE" --go-base "$GO_BASE" --diffs "$OUT/diffs" "$@"
fi

echo "== the fake connected app and Postmark, on $FAKE_PORT"
python3 script/parity/fake_app.py "$FAKE_PORT" > "$OUT/fake.log" 2>&1 &
pids+=($!)
wait_for "$FAKE_BASE/_mails" "the fake app"

echo "== Rails, on $RAILS_PORT"
prepare_db "$OUT/rails.sqlite3"
PARITY_PORT=$RAILS_PORT PARITY_FAKE=127.0.0.1:$FAKE_PORT \
  DATABASE_URL="sqlite3:$OUT/rails.sqlite3" \
  bundle exec ruby script/parity/serve.rb > "$OUT/rails.log" 2>&1 &
pids+=($!)

echo "== Go, on $GO_PORT"
prepare_db "$OUT/go.sqlite3"
# Rails' empty vendor/ turns Go's vendoring on, and then fails on the missing
# vendor/modules.txt; -mod=readonly means "ignore it". Goes away in phase 9.
GOFLAGS=-mod=readonly go build -o "$OUT/tinystart" ./cmd/tinystart
TINYSTART_ADDR=":$GO_PORT" TINYSTART_DB="$OUT/go.sqlite3" \
  TINYSTART_SECRET_KEY=parity-secret-key-not-a-real-one \
  TINYSTART_HOST="$GO_BASE" \
  POSTMARK_API_TOKEN=parity-fake-token POSTMARK_API_URL="$FAKE_BASE" \
  "$OUT/tinystart" > "$OUT/go.log" 2>&1 &
pids+=($!)

wait_for "$RAILS_BASE/up" "Rails"
wait_for "$GO_BASE/up" "the Go app"

# One side at a time, because both drive the same fake: the device flow has one
# state and the mailbox one set of messages.
echo "== capturing Rails"
python3 script/parity/capture.py --base "$RAILS_BASE" --db "$OUT/rails.sqlite3" \
  --fake "$FAKE_BASE" --out "$OUT/rails" --fixture "$FIXTURE" > "$OUT/rails-capture.log"
tail -1 "$OUT/rails-capture.log"

echo "== capturing Go"
python3 script/parity/capture.py --base "$GO_BASE" --db "$OUT/go.sqlite3" \
  --fake "$FAKE_BASE" --out "$OUT/go" --fixture "$FIXTURE" > "$OUT/go-capture.log"
tail -1 "$OUT/go-capture.log"

if [ "$(source_fingerprint)" != "$BEFORE" ]; then
  echo "$SOURCE_DB changed during the run — something wrote to the source instead of a copy" >&2
  exit 1
fi

echo
python3 script/parity/diff.py --rails "$OUT/rails" --go "$OUT/go" \
  --rails-base "$RAILS_BASE" --go-base "$GO_BASE" --diffs "$OUT/diffs" "$@"
