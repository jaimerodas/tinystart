#!/usr/bin/env bash
# prove_it: full test suite—runs before every git commit
#
# The gate for the Go app.
set -e
trap 'rc=$?; command -v prove_it >/dev/null 2>&1 && prove_it record --name full-tests --result $rc' EXIT

cd "$(dirname "$0")/.."

# gofmt has no exit code for "would reformat": it only names the files, so the
# check is that it named none.
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "gofmt would reformat:"
  echo "$unformatted"
  exit 1
fi

go vet ./...

# staticcheck and govulncheck are tool directives in go.mod, so go.mod pins
# the version there and nothing has to be installed globally.
go tool staticcheck ./...
go tool govulncheck ./...

# -race because the server, its shutdown, and the tests that drive it all run
# on separate goroutines. Without -race, a data race here surfaces in
# production instead.
go test -race ./...

# The browser suite: internal/web/browser_*_test.go, behind //go:build browser
# so the run above never sees them. They need Chrome — this machine and the CI
# runner both have one. The tests run when the script finds Chrome, and they
# announce a skip when it does not. Skipping quietly is how a suite stops
# running at all.
#
# Not -race: nothing here exercises the server differently from the tests
# above, and the browser is slow enough already.
chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
if [ -x "$chrome" ] || command -v google-chrome >/dev/null 2>&1; then
  echo "==> browser tests (chromedp)"
  go vet -tags browser ./internal/web
  go tool staticcheck -tags browser ./internal/web
  go test -tags browser -run Browser ./internal/web
else
  echo "==> browser tests skipped: no Chrome on this machine"
fi
