# Ignore all environment files.
/.env*

# The development database (and whatever SQLite leaves beside it).
/storage/*
!/storage/.keep

# Ignore per-machine Claude Code state. The shared bits — CLAUDE.md and
# .claude/rules/ — stay in the repo on purpose.
/.claude/**/*.local.json
/.claude/worktrees/

# Go: the binary a bare `go build` drops at the repo root, and the coverage
# profile `go test -coverprofile` writes. The module and build caches live
# outside the tree, so nothing else needs ignoring.
/tinystart
/coverage.out
