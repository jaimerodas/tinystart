<%# The add-link affordance at the foot of a group. Rendered already open after
    a successful add, so several links can be typed in a row. %>
<div id="<%= new_item_dom_id(group) %>"
     class="inline-form-slot"
     data-controller="inline-form"
     data-inline-form-open-value="<%= local_assigns.fetch(:open, false) %>">
  <%= add_item_trigger(group) %>

  <%= tag.div class: "inline-form",
              hidden: true,
              data: { inline_form_target: "form",
                      action: "keydown.esc->inline-form#close" } do %>
    <%= render "start_page_items/form", item: item, group: group %>
  <% end %>
</div>
