<main class="start-page" data-controller="command-bar start-shortcuts"
      data-command-bar-links-value="<%= @links_json %>"
      data-command-bar-federation-value="<%= federation_state(@connection) %>"
      data-command-bar-source-value="<%= @connection&.hostname %>"
      data-start-shortcuts-edit-value="<%= edit_start_path %>"
      data-action="keydown@window->start-shortcuts#keydown turbo:before-cache@window->start-shortcuts#closeDialog">
  <%= start_page_header %>

  <%= render "start_pages/shortcuts_dialog", shortcuts: show_page_shortcuts %>

  <% if @connection&.needs_reconnect? %>
    <%# Federated results failing quietly looks exactly like an empty archive,
        so say so rather than showing nothing. %>
    <p class="search-disconnected" role="status">
      Search of <%= @connection.hostname %> is disconnected.
      <%= link_to "Reconnect", settings_connections_path %>.
    </p>
  <% end %>

  <section class="command-bar">
    <input type="text"
           data-command-bar-target="input"
           data-action="input->command-bar#search keydown->command-bar#handleKeydown"
           placeholder="Search links, web, or type URL..."
           spellcheck="false"
           autocomplete="off"
           autofocus>
    <div class="command-bar-suggestions" data-command-bar-target="suggestions">
      <!-- Dynamic suggestions will be inserted here -->
    </div>
  </section>

  <%# Without this an untouched start page is just a command bar over blank space,
      with nothing saying the grid is empty rather than broken. %>
  <% unless @has_tiles %>
    <p class="start-page-empty">
      No links added yet, <%= link_to "edit the page", edit_start_path %> to add some.
    </p>
  <% end %>

  <section class="start-page-grid" data-columns="<%= current_user.columns %>" data-controller="visit-tracker">
    <% current_user.column_range.each do |column_number| %>
      <div class="start-page-column">
        <% groups_in_column = @groups_by_column[column_number] || [] %>
        <% groups_in_column.each do |group| %>
          <section>
            <h2><%= group.name %></h2>
            <ul>
              <% group.ordered_items.each do |item| %>
                <li>
                  <%= link_to item.title, item.url, data: { item_id: item.id } %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% end %>
  </section>
</main>
