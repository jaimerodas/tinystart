<main class="start-page" data-controller="command-bar" data-command-bar-links-value="<%= @links_json %>">
  <%= start_page_header %>

  <% if @tinylinks_connection&.needs_reconnect? %>
    <%# Federated results failing quietly looks exactly like an empty archive,
        so say so rather than showing nothing. %>
    <p class="tinylinks-disconnected" role="status">
      Search of your TinyLinks archive is disconnected.
      <%= link_to "Reconnect", settings_tinylinks_path %>.
    </p>
  <% end %>

  <section class="command-bar">
    <input type="text"
           data-command-bar-target="input"
           data-action="input->command-bar#search keydown->command-bar#handleKeydown"
           placeholder="Search links, web, or type URL..."
           spellcheck="false"
           autocomplete="off"
           autofocus>
    <div class="command-bar-suggestions" data-command-bar-target="suggestions">
      <!-- Dynamic suggestions will be inserted here -->
    </div>
  </section>

  <section class="start-page-grid" data-columns="<%= current_user.columns %>" data-controller="visit-tracker">
    <% current_user.column_range.each do |column_number| %>
      <div class="start-page-column">
        <% groups_in_column = @groups_by_column[column_number] || [] %>
        <% groups_in_column.each do |group| %>
          <section>
            <h2><%= group.name %></h2>
            <ul>
              <% group.ordered_items.each do |item| %>
                <li>
                  <%= link_to item.title, item.url, data: { item_id: item.id } %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% end %>
  </section>
</main>
