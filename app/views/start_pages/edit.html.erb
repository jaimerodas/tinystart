<main class="start-page"
      data-controller="start-shortcuts"
      data-start-shortcuts-view-value="<%= root_path %>"
      data-action="keydown@window->start-shortcuts#keydown turbo:before-cache@window->start-shortcuts#closeDialog">
  <%= start_page_header %>

  <%= render "start_pages/shortcuts_dialog", shortcuts: editor_shortcuts %>

  <%# One strip above the grid: how to drive it on the left, how wide it is on
      the right. The legend focuses nothing, so the select stays the last tab
      stop before the grid whichever way round they sit. %>
  <div class="editor-toolbar">
    <%= render "start_pages/keyboard_legend" %>
    <%= render "start_pages/column_count", user: current_user %>
  </div>

  <%= render "start_pages/notice_region" %>

  <%# Everything is edited where it lives: groups are added at the foot of a
      column, links at the foot of a group. %>
  <%= render "grid", user: current_user, groups_by_column: @groups_by_column %>
</main>
