<section id="start_page_grid" class="start-page-grid" data-columns="<%= user.columns %>" data-controller="drag-drop">
  <% user.column_range.each do |column_number| %>
    <%= render "start_pages/column",
               column_number: column_number,
               groups: groups_by_column[column_number] || [] %>
  <% end %>
</section>
