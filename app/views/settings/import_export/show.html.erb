<% content_for :title, "Import & Export" %>

<main>
  <nav class="dual-nav">
    <ol class="breadcrumbs">
      <li><%= link_to "Settings", settings_path %></li>
      <li>Import &amp; Export</li>
    </ol>

    <%= settings_secondary_nav("Import & Export") %>
  </nav>

  <%# The export half has no heading: the button names the action, and a heading
      reading "Export" above a control reading "Export" is one word twice.
      Import keeps its heading, because it owns the warning under the row and
      that is what separates the two halves now. %>
  <section class="user-section" id="import-export">
    <p>Your start page — every group and link in it — as a small YAML file you
      can read, edit and hand back. It carries the layout, not the visit counts
      the command bar ranks by, so it isn't a backup.</p>

    <%# data-turbo: false because Turbo Drive intercepts link clicks and has
        nothing to do with an attachment response. %>
    <%= link_to "Export all groups and links", settings_export_path,
          class: "export-action", data: { turbo: false } %>

    <h3>Import</h3>
    <%= form_with url: settings_import_export_path, method: :post,
          class: "import-form" do |form| %>
      <%# form.file_field, not file_field_tag: the builder is what sets the
          form's multipart enctype, and without it the upload arrives empty.
          No visible label — the row is two controls wide and "File" above a
          picker that already says "Choose file" earns nothing. The accessible
          name comes from aria-label, which is how the field is still reachable
          by name to a screen reader and to Capybara. %>
      <%= form.file_field :file, accept: ".yml,.yaml",
            "aria-label": "Start page file to import" %>

      <%= form.submit "Import",
            data: { turbo_confirm: "This replaces every group and link on your start page. Continue?" } %>

      <p class="help-text">Importing <b>replaces</b> every group and link on
        your start page with what is in the file. If anything in it is
        rejected, nothing is changed at all.</p>
    <% end %>
  </section>
</main>
