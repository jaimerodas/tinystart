<% content_for :title, "Users" %>

<main>
  <nav class="dual-nav">
    <ol class="breadcrumbs">
      <li><%= link_to "Settings", settings_path %></li>
      <li>Users</li>
    </ol>

    <%= settings_secondary_nav("Users") %>
  </nav>

  <ul id="users-list" class="item-list">
    <% @users.each do |user| %>
      <%= render user %>
    <% end %>
  </ul>
</main>
