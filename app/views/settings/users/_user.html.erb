<li id="<%= dom_id user %>" class="item user">
  <div class="item-info">
    <h3><%= user.email %></h3>
    <div class="item-meta">
      <%= user_status(user) %>
      <% if user.admin? %>
        &middot; <span class="user-admin">Admin</span>
      <% end %>
    </div>
  </div>

  <div class="item-actions">
    <%= reset_password(user) %>
    <%= status_toggle(user) %>
  </div>
</li>
