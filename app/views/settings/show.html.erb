<% content_for :title, "Settings" %>

<main>
  <nav class="dual-nav">
    <ol class="breadcrumbs">
      <li>Settings</li>
    </ol>
    <%= settings_secondary_nav("Main") %>
  </nav>


  <%# Above the first heading on purpose: it is the one thing here worth a
      glance rather than a read. Not links — the way to the page is "Start" in
      the menu below, and Edit from there. %>
  <% links = current_user.start_page_items.count %>
  <% groups = current_user.start_page_groups.count %>
  <section id="start-page-stats" aria-label="Start page contents">
    <div class="stat">
      <span class="stat-value"><%= links %></span>
      <span class="stat-label"><%= "link".pluralize(links) %></span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= groups %></span>
      <span class="stat-label"><%= "group".pluralize(groups) %></span>
    </div>
  </section>

  <section id="user-details" class="user-section">
    <h2>Account</h2>
    <ul>
      <li><b>Email:</b> <%= current_user.email %></li>
      <%# The date is the fact; the relative span is the thing you actually
          wanted to know. "User since: 3 months" was neither. %>
      <li>
        <b>Member since:</b>
        <time datetime="<%= current_user.created_at.iso8601 %>">
          <%= current_user.created_at.strftime("%-d %B %Y") %>
        </time>
        (<%= time_ago_in_words(current_user.created_at) %> ago)
      </li>
      <li><%= link_to "Change password", edit_settings_password_path %></li>
    </ul>
  </section>

  <section id="user-display" class="user-section">
    <h2>Display</h2>
    <%= form_with model: current_user, url: settings_path, method: :patch, data: { controller: "theme", action: "turbo:submit-end->theme#updateTheme" } do |form| %>
      <div class="form-group">
        <label>Theme</label>
        <div class="radio-group">
          <div class="radio-field">
            <%= form.radio_button :theme_preference, "system", id: "theme_system" %>
            <%= form.label :theme_preference, "System", value: "system", for: "theme_system" %>
          </div>
          <div class="radio-field">
            <%= form.radio_button :theme_preference, "light", id: "theme_light" %>
            <%= form.label :theme_preference, "Light", value: "light", for: "theme_light" %>
          </div>
          <div class="radio-field">
            <%= form.radio_button :theme_preference, "dark", id: "theme_dark" %>
            <%= form.label :theme_preference, "Dark", value: "dark", for: "theme_dark" %>
          </div>
        </div>
        <p class="help-text">Choose your preferred color scheme. System will follow your device's theme setting.</p>
      </div>

      <div class="form-group">
        <label>Accent color</label>
        <div class="color-picker">
          <% User::VALID_COLORS.each do |color| %>
            <div class="color-option">
              <%= form.radio_button :color_preference, color, id: "color_#{color}" %>
              <%# The swatch paints itself from the palette token, so adding an
                  accent means touching VALID_COLORS and colors.css, nothing else. %>
              <%= label_tag "color_#{color}", "", data: { color: color },
                    style: "background: var(--accent-#{color})" %>
            </div>
          <% end %>
        </div>
        <p class="help-text">Choose your preferred accent color for links and interface elements.</p>
      </div>

      <%# The column count is not here: it belongs on /start/edit, next to the
          columns it describes and the groups a shrink would strand. %>
      <%# "Update display" read like it was going to redraw something. It saves
          the two preferences above it, so it says so. %>
      <%= form.submit "Save display preferences", class: "action-button" %>
    <% end %>
  </section>

</main>
