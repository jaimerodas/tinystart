<% content_for :title, "Password" %>
<main data-controller="passwords">
  <nav class="dual-nav">
    <ol class="breadcrumbs">
      <li><%= link_to "Settings", settings_path %></li>
      <li>Password</li>
    </ol>

    <%= settings_secondary_nav("Main") %>
  </nav>

  <%= form_for(@user, url: settings_password_path) do |form| %>
  <h2>Change your password</h2>
  <% if @user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@user.errors.count, "error") %> prohibited this from being saved:</h2>

      <ul>
        <% @user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :existing_password %>
    <%= form.password_field :existing_password, "data-passwords-target": "password" %>
  </div>

  <div>
    <%= form.label :new_password %>
    <%= form.password_field :new_password, "data-passwords-target": "password" %>
  </div>

  <div>
    <%= form.submit %>
  </div>

  <% end %>

  <section class="form-actions" data-passwords-target="actions">
  </section>
</main>
