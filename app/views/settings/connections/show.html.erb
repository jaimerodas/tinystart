<% content_for :title, "Connections" %>

<main>
  <nav class="dual-nav">
    <ol class="breadcrumbs">
      <li><%= link_to "Settings", settings_path %></li>
      <li>Connections</li>
    </ol>

    <%= settings_secondary_nav("Connections") %>
  </nav>

  <%# No heading here: the tab, the breadcrumb and the title all say
      Connections, so a fourth one would only repeat them. The paragraph does
      the explaining a heading can't. %>
  <section class="user-section" id="connection-settings">
    <p>Connect other apps so the command bar can search them alongside your
      tiles. Connecting asks the other app to approve TinyStart, which hands
      back a token stored here.</p>

    <% if @pending %>
      <%# Waiting on approval in the other tab. The poller flips this itself. %>
      <div class="connection-status pending"
           data-controller="device-flow"
           data-device-flow-url-value="<%= poll_settings_connections_path %>">
        <p>
          <strong>Waiting for approval.</strong>
          Approve TinyStart in the other app, then come back — this page updates on its own.
        </p>
        <p>
          <%# The one thing to do while pending, so it gets the button every
              other action in Settings gets rather than the start page's subdued
              .button-link. %>
          <%= link_to "Open the approval page", @pending["verification_url"],
                target: "_blank", rel: "noopener", class: "action-button" %>
        </p>
        <p class="help-text" data-device-flow-target="status">Checking…</p>
      </div>

    <% elsif @connection && !@connection.needs_reconnect? %>
      <%# Disconnect lives inside the box: it acts on this connection, and left
          outside it read as an action on the section. %>
      <%# Three tiers, and they used to be one: the state, the token's facts
          under it, and a footnote about renewal. The classes were .item-meta and
          .help-text, both of which are scoped to other components — inside
          .item-list .item and inside a form's .form-group — so all three lines
          rendered as identical body text. These names belong to this box. %>
      <div class="connection-status connected">
        <p class="connection-state"><strong>Connected</strong> to <%= @connection.base_url %></p>

        <p class="connection-facts">
          <%= @connection.scope_list || "full access" %>
          <% if @connection.token_expires_at %>
            &middot; token expires <%= distance_of_time_in_words(Time.current, @connection.token_expires_at) %> from now
          <% end %>
        </p>

        <p class="connection-note">The token renews itself every time the command bar
          uses it, so it only lapses after a long silence.</p>

        <%= button_to "Disconnect", settings_connections_path, method: :delete,
              class: "action-button danger",
              data: { turbo_confirm: "Disconnect #{@connection.hostname}? Its results will stop appearing in the command bar." } %>
      </div>

    <% else %>
      <% if @connection&.needs_reconnect? %>
        <div class="connection-status disconnected">
          <p><strong>Disconnected.</strong> <%= @connection.last_error %></p>
        </div>
      <% end %>

      <%= form_with url: settings_connections_path, method: :post, class: "connect-form" do |form| %>
        <div class="field">
          <%= form.label :base_url, "App address" %>
          <%= form.url_field :base_url,
                value: @connection&.base_url || Settings::ConnectionsController::DEFAULT_BASE_URL,
                required: true %>
        </div>
        <%= form.submit "Connect", class: "action-button" %>
      <% end %>
    <% end %>
  </section>
</main>
