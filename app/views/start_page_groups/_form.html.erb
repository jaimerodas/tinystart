<%# The same form adds a group and renames one. The column is never asked for:
    when adding, the form's own place in the grid already answers it. %>
<%= form_with model: group,
              url: group.persisted? ? start_group_path(group) : start_groups_path,
              class: "inline-form-body" do |form| %>
  <%= render "shared/form_errors", record: group %>

  <% unless group.persisted? %>
    <%= form.hidden_field :column, value: column_number %>
  <% end %>

  <%# data-pristine is what Cancel restores. After a rejected save the field
      holds the value that was refused, so "discard" cannot mean "reset to the
      rendered value" — it has to mean the one on disk. %>
  <%= form.text_field :name,
        class: "control",
        required: true,
        placeholder: "Group name",
        aria: { label: "Group name" },
        data: { inline_form_target: "field", pristine: group.name_in_database.to_s } %>

  <div class="inline-form-actions">
    <%= form.submit group.persisted? ? "Save" : "Add", class: "control" %>
    <button type="button" class="control secondary" data-action="click->inline-form#close">Cancel</button>
  </div>
<% end %>
