<%# The contents of the notice region, not the region itself — see
    start_pages/_notice_region. A stream updates this into the live region that
    is already on the page, because a screen reader announces a change inside a
    region it already knows, not the arrival of a region with the text already
    in it. %>
<% if message.present? %>
  <p class="start-page-notice-error"><%= message %></p>
<% end %>
